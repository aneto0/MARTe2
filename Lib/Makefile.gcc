GCC_VERSION := $(shell $(CXX) -dumpfullversion -dumpversion)
GCC_MAJOR   := $(word 1,$(subst ., ,$(GCC_VERSION)))

ifeq ($(DISABLE_GTEST_VERSION_AUTODETECT),1)
    GTEST_VERSION := 1.7.0
else
    ifeq ($(shell test $(GCC_MAJOR) -ge 11 && echo yes),yes)
        GTEST_VERSION := 1.18.0
    else ifeq ($(shell test $(GCC_MAJOR) -ge 9 && echo yes),yes)
        GTEST_VERSION := 1.16.0
    else
        GTEST_VERSION := 1.7.0
    endif
endif


SPBT = gtest-$(GTEST_VERSION)

all: 
	make -C $(SPBT) -f Makefile.gcc
	mkdir -p gtest
	cp -R gtest-$(GTEST_VERSION)/*.a gtest/
	cp -R gtest-$(GTEST_VERSION)/include/ gtest/

clean:
	make -C $(SPBT) -f Makefile.gcc clean
	rm -rf gtest


